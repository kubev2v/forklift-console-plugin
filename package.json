{
  "name": "forklift-console-plugin",
  "version": "2.11.0",
  "description": "UI for forklift as an openshift console dynamic plugin",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "repository": "https://github.com/kubev2v/forklift-console-plugin.git",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "scripts": {
    "clean": "rm -rf ./dist ./coverage",
    "clean:all": "npm run clean && rm -rf ./node_modules ./tmp",
    "build": "NODE_ENV=production NODE_OPTIONS=--max-old-space-size=8192 webpack",
    "build:analyze": "ANALYZE_BUNDLE=true NODE_ENV=production webpack",
    "start": "NODE_ENV=development webpack serve --progress",
    "i18n": "i18next \"./src/**/*.{js,jsx,ts,tsx}\" ./plugin-extensions.ts [-oc] -c ./i18next-parser.config.ts && ocp-i18n-defaults && ocp-i18n-fix-plurals && ocp-i18n-replace-br",
    "i18n-to-po": "ocp-i18n-to-po",
    "i18n-dummy-locale": "ocp-i18n-dummy-locale",
    "export-pos": "ocp-i18n-export-pos",
    "po-to-i18n": "ocp-i18n-po-to-i18n",
    "memsource-upload": "ocp-i18n-memsource-upload",
    "memsource-download": "ocp-i18n-memsource-download",
    "lint": "eslint 'src/**/*.{ts,tsx,js,jsx}' plugin-extensions.ts plugin-metadata.ts environment-defaults.ts --cache --cache-location .eslintcache && stylelint \"src/**/*.css\" --allow-empty-input",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.css\" --allow-empty-input --fix",
    "lint:ia": "rm -rf node_modules/.cache/eslint-interactive && npx eslint-interactive .",
    "test:i18n": "bash ./ci/test-i18n.sh",
    "test": "TZ=UTC jest",
    "test:coverage": "TZ=UTC jest --coverage",
    "test:updateSnapshot": "TZ=UTC jest --updateSnapshot",
    "test:e2e": "npm --prefix testing run test:e2e",
    "console": "bash ./ci/start-console.sh",
    "console:stop": "bash ./ci/stop-console.sh",
    "cluster:up": "bash ./ci/deploy-all.sh",
    "cluster:delete": "bash ./ci/clean-cluster.sh",
    "e2e:cluster": "bash ./ci/deploy-cluster.sh",
    "e2e:build": "bash ./ci/build-and-push-images.sh",
    "e2e:deployCrds": "kubectl apply -f ./ci/yaml/crds/forklift",
    "e2e:console": "bash ./ci/deploy-console.sh",
    "e2e:pre-test": "npm run e2e:cluster && npm run e2e:build && npm run e2e:deployCrds && npm run e2e:console",
    "knip": "knip",
    "validate-commits": "bash ./scripts/validate-commits.sh --verbose",
    "validate-commits-range": "bash ./scripts/validate-commits.sh --range",
    "postinstall": "husky"
  },
  "dependencies": {
    "@forklift-ui/types": "^1.0.10",
    "@openshift-console/dynamic-plugin-sdk": "^4.20.0",
    "@patternfly/patternfly": "6.4.0",
    "@patternfly/quickstarts": "6.4.0",
    "@patternfly/react-charts": "8.4.0",
    "@patternfly/react-code-editor": "^6.4.0",
    "@patternfly/react-component-groups": "6.4.0",
    "@patternfly/react-core": "6.4.0",
    "@patternfly/react-drag-drop": "6.4.0",
    "@patternfly/react-icons": "6.4.0",
    "@patternfly/react-styles": "6.4.0",
    "@patternfly/react-table": "6.4.0",
    "@patternfly/react-tokens": "6.4.0",
    "classnames": "^2.5.1",
    "i18next": "^26.0.0",
    "immer": "^11.0.0",
    "immutable": "^5.1.5",
    "js-base64": "^3.7.7",
    "jsonpath-plus": "^10.3.0",
    "jsrsasign": "11.1.2",
    "luxon": "^3.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^17.0.0",
    "react-linkify": "^1.0.0-alpha",
    "react-router-dom": "7.18.x",
    "react-router-dom-v5-compat": "^6.22.0",
    "react-tagsinput": "^3.19.0",
    "victory-area": "^37.3.6",
    "victory-axis": "^37.3.6",
    "victory-bar": "^37.3.6",
    "victory-box-plot": "^37.3.6",
    "victory-chart": "^37.3.6",
    "victory-core": "^37.3.6",
    "victory-create-container": "^37.3.6",
    "victory-cursor-container": "^37.3.6",
    "victory-group": "^37.3.6",
    "victory-legend": "^37.3.6",
    "victory-line": "^37.3.6",
    "victory-pie": "^37.3.6",
    "victory-scatter": "^37.3.6",
    "victory-stack": "^37.3.6",
    "victory-tooltip": "^37.3.6",
    "victory-voronoi-container": "^37.3.6",
    "victory-zoom-container": "^37.3.6"
  },
  "devDependencies": {
    "@cspell/eslint-plugin": "^10.0.0",
    "@eslint/js": "^10.0.0",
    "@jest/globals": "^30.0.0",
    "@openshift-console/dynamic-plugin-sdk-webpack": "4.22.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/i18next": "^13.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsrsasign": "10.5.15",
    "@types/luxon": "^3.4.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-redux": "^7.1.34",
    "@types/react-tagsinput": "^3.20.6",
    "@types/webpack-bundle-analyzer": "^4.7.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-interactive": "^14.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-perfectionist": "^5.0.0",
    "eslint-plugin-prettier": "^5.2.5",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "fork-ts-checker-webpack-plugin": "^9.0.2",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "i18next-parser": "^9.3.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "knip": "^6.0.0",
    "lint-staged": "^17.0.0",
    "mini-svg-data-uri": "^1.4.4",
    "monaco-editor": "^0.52.2",
    "ocp-plugin-i18n-scripts": "^1.0.2",
    "prettier": "^3.5.3",
    "sass": "^1.86.0",
    "sass-loader": "^17.0.0",
    "style-loader": "^4.0.0",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "ts-jest": "^29.3.0",
    "ts-loader": "^9.3.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths-webpack-plugin": "^4.0.0",
    "typescript": "^7.0.0",
    "typescript-eslint": "^8.28.0",
    "webpack": "^5.103.0",
    "webpack-bundle-analyzer": "^5.0.0",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^6.0.0"
  },
  "overrides": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dompurify": ">=3.4.7",
    "linkify-it": "6.1.0",
    "lodash": "4.18.1",
    "monaco-editor": "^0.52.2",
    "node-forge": "^1.3.2",
    "qs": "6.14.1"
  }
}
